# Copy to .env.local for local `npm run dev`. Gitignored.
#
# Note the host differs from docker-compose: inside compose the database is
# reachable as "db", but the dev server runs on your machine and talks to the
# published port instead.
DATABASE_URL=postgres://distiller:distiller@localhost:5432/distiller

# Where rendered mp3s are written. Relative paths are fine in dev.
DATA_DIR=./data

# The UI password gate. Unset means open access plus a loud warning.
APP_PASSWORD=localdev

# Optional - only needed for the plugins you actually configure.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
