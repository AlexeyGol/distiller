# Copy to .env and fill in. .env is gitignored.

# --- Web UI ---------------------------------------------------------------
# Required. This UI fronts a real Google credential, so it is not left open.
APP_PASSWORD=change-me
APP_PORT=3000

# --- Database -------------------------------------------------------------
POSTGRES_USER=distiller
POSTGRES_PASSWORD=distiller
POSTGRES_DB=distiller
POSTGRES_PORT=5432

# --- Scheduling -----------------------------------------------------------
# How often to poll sources. Per-topic digest cadence is set in the UI.
POLL_SCHEDULE=*/30 * * * *

# --- NotebookLM sidecar ---------------------------------------------------
# The auth directory is mounted read-only at /auth. It must contain BOTH
# storage_state.json and master_token.json under profiles/<NLM_PROFILE>/.
NLM_PROFILE=default

# --- Renderer credentials -------------------------------------------------
# Set whichever provider you configure on a topic's llm-text renderer.
# Gemini has a free AI Studio tier that is ample at this volume.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- YouTube search source ------------------------------------------------
# YouTube Data API v3 key. search.list costs 100 units of a 10,000/day quota,
# so roughly 100 searches per day.
YOUTUBE_API_KEY=

# --- Telegram sink --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
